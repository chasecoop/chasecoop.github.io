---
import { type CollectionEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, next: projects[i + 1] },
	}));
}
interface Props {
	project: CollectionEntry<'projects'>;
	next?: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { title, summary, date, tech, scene, repo } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary} type="article">
	<article>
		<header class="col page">
			<p class="crumb"><a class="dim" href="/projects/">projects</a> / {project.id}</p>
			<div class="heading">
				<h1 class="title">{title}</h1>
				<span class="muted">{date.getUTCFullYear()}</span>
			</div>
			<p class="summary">{summary}</p>
		</header>

		{
			scene && (
				<figure class="col-wide stage-wrap">
					<div class="stage">
						<canvas data-scene={scene} aria-label={`Interactive 3D scene: ${title}`} />
						<noscript>
							<p class="noscript">This project needs JavaScript to run.</p>
						</noscript>
					</div>
					<figcaption class="muted">drag to spin</figcaption>
				</figure>
			)
		}

		<section class="col notes" aria-labelledby="notes">
			<h2 id="notes">notes</h2>
			<div class="prose">
				<Content />
			</div>
			<dl>
				{
					tech.length > 0 && (
						<div class="row">
							<dt>tech</dt>
							<dd>{tech.join(', ')}</dd>
						</div>
					)
				}
				{
					repo && (
						<div class="row">
							<dt>source</dt>
							<dd>
								<a href={repo} rel="noopener">
									{repo.replace(/^https:\/\//, '')}
								</a>
							</dd>
						</div>
					)
				}
			</dl>

			<nav class="pager" aria-label="More projects">
				<a href="/projects/">&lt;- all projects</a>
				{
					next && (
						<span>
							<span class="muted">next </span>
							<a class="quiet" href={`/projects/${next.id}/`}>
								{next.data.title}
							</a>
						</span>
					)
				}
			</nav>
		</section>
	</article>
</Base>

<script>
	// Each project's scene lives in its own module under src/scripts/three/.
	// import.meta.glob code-splits them, so Three.js only downloads on pages
	// that actually mount a scene.
	const scenes = import.meta.glob<{ mount: (canvas: HTMLCanvasElement) => () => void }>('../../scripts/three/*.ts');

	for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas[data-scene]')) {
		const load = scenes[`../../scripts/three/${canvas.dataset.scene}.ts`];
		if (!load) {
			console.error(`No scene module named "${canvas.dataset.scene}"`);
			continue;
		}
		load().then(({ mount }) => {
			const dispose = mount(canvas);
			addEventListener('pagehide', dispose, { once: true });
		});
	}
</script>

<style>
	.page {
		margin-top: var(--space-6);
	}
	.heading {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-2) var(--space-4);
	}
	.summary {
		margin-top: var(--space-2);
	}
	.stage-wrap {
		margin-block: var(--space-5) 0;
	}
	.stage {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--stage-bg);
		color: var(--tile-fg);
		border-radius: var(--radius);
		cursor: grab;
	}
	.stage:active {
		cursor: grabbing;
	}
	.stage canvas {
		width: 100%;
		height: 100%;
		touch-action: none;
	}
	.noscript {
		position: absolute;
		inset: auto var(--space-3) var(--space-3);
	}
	figcaption {
		margin-top: var(--space-2);
		font-size: var(--text-xs);
	}
	.notes {
		margin-top: var(--space-5);
	}
	.notes h2 {
		margin-bottom: var(--space-3);
	}
	dl {
		margin: var(--space-4) 0 0;
	}
	dd {
		margin: 0;
		overflow-wrap: anywhere;
	}
</style>
