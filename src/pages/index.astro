---
import PostList from '../components/PostList.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts, getProjects } from '../lib/content';

const projects = await getProjects();
const posts = (await getPosts()).slice(0, 4);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="col">
		<p class="intro muted">{SITE_DESCRIPTION}</p>

		<section aria-labelledby="projects">
			<div class="section-head">
				<h2 id="projects">projects</h2>
				<span class="muted">{String(projects.length).padStart(2, '0')}</span>
			</div>
			<ProjectGrid projects={projects} />
		</section>

		<section aria-labelledby="writing" class="writing">
			<div class="section-head">
				<h2 id="writing">writing</h2>
				<a href="/blog/">all posts -&gt;</a>
			</div>
			<PostList posts={posts} />
		</section>
	</div>
</Base>

<style>
	.intro {
		margin: var(--space-6) 0 var(--space-5);
	}
	.writing {
		margin-top: var(--space-6);
	}
	.writing .section-head {
		margin-bottom: var(--space-3);
	}
</style>
