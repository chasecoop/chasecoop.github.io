---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import ProjectWall from '../components/ProjectWall.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/content';

const tiles = await getCollection('tiles');
const posts = (await getPosts()).slice(0, 4);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<p class="col intro muted">{SITE_DESCRIPTION}</p>

	<section aria-labelledby="projects">
		<div class="col section-head">
			<h2 id="projects">projects</h2>
			<span class="muted">{String(tiles.length).padStart(2, '0')}</span>
		</div>
		<ProjectWall />
	</section>

	<section aria-labelledby="writing" class="col writing">
		<div class="section-head">
			<h2 id="writing">writing</h2>
			<a href="/blog/">all posts -&gt;</a>
		</div>
		<PostList posts={posts} />
	</section>
</Base>

<style>
	.intro {
		margin: var(--page-top) 0 var(--space-5);
	}
	.writing {
		margin-top: var(--space-6);
	}
	.writing .section-head {
		margin-bottom: var(--space-3);
	}
</style>
