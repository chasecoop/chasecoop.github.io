---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import order from '../../content/launch.yaml?raw';
import Base from '../../layouts/Base.astro';

// Tiles come from src/content/launch.yaml, in file order (getCollection sorts
// by id, so re-sort by where each id appears). A thumbnail is line art (an SVG
// drawn with currentColor, inlined) or a still, cropped square.
const ids = [...order.matchAll(/^- id: (\S+)/gm)].map((m) => m[1]);
const tiles = (await getCollection('launch')).sort((a, b) => ids.indexOf(a.id) - ids.indexOf(b.id));
const svgs = import.meta.glob<string>('../../assets/launch/*.svg', { query: '?raw', import: 'default', eager: true });
const stills = import.meta.glob<ImageMetadata>('../../assets/launch/*.{png,jpg,jpeg,webp,avif}', {
	import: 'default',
	eager: true,
});
const art = (id: string, thumbnail?: string) => {
	const key = `../../assets/launch/${thumbnail ?? `${id}.svg`}`;
	return { svg: svgs[key], still: stills[key] };
};
---

<Base title="Launch" description="Apps, games and 3D experiments you can open and run." wide>
	<h1 class="sr-only">launch</h1>
	<ul class="grid">
		{
			tiles.map(({ id, data }) => {
				const { svg, still } = art(id, data.thumbnail);
				const Tile = data.url ? 'a' : 'span';
				return (
					<li>
						<Tile class:list={['tile', { still: !svg && still }]} {...(data.url ? { href: data.url, target: '_blank', rel: 'noopener' } : {})}>
							<span class="frame">
								{svg ? <Fragment set:html={svg} /> : still ? <Image src={still} width={640} alt="" /> : null}
							</span>
							<span class="cap">
								<span class="app">{data.name}</span>
								<span class="desc">
									<span class="kind">{data.kind}</span> / {data.description}
									{!data.url && ' / [URL]'}
								</span>
							</span>
						</Tile>
					</li>
				);
			})
		}
	</ul>
</Base>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 2px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tile {
		position: relative;
		display: block;
		color: var(--tile-fg);
		text-decoration: none;
	}
	a.tile:hover,
	.tile:focus-visible {
		color: var(--link);
		text-decoration: none;
	}
	.tile:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: -2px;
	}
	.frame {
		position: relative;
		display: block;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		background: var(--tile-bg);
	}
	.frame :global(svg),
	.frame :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.frame :global(img) {
		object-fit: cover;
	}
	.frame :global(svg) {
		stroke-width: 1.25px;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.frame :global(svg *) {
		vector-effect: non-scaling-stroke;
	}
	.frame :global(.solid) {
		fill: currentColor;
		stroke: none;
	}
	.frame :global(.dash) {
		stroke-dasharray: 2 3;
	}
	.cap {
		position: absolute;
		inset: auto 0 0;
		padding: var(--space-2) var(--space-3);
		background: var(--bg);
		font-size: var(--text-xs);
		line-height: 1.45;
		opacity: 0;
		transition: opacity 0.12s;
	}
	.tile:hover .cap,
	.tile:focus-visible .cap {
		opacity: 1;
	}
	.app {
		display: block;
		color: var(--fg);
		font-weight: 500;
	}
	.desc {
		display: block;
		color: var(--muted);
	}
	.kind {
		color: var(--fg);
	}
	/* Phones: two columns, and the name always shows. */
	@media (max-width: 640px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.cap {
			background: none;
			opacity: 1;
		}
		.desc {
			display: none;
		}
		/* Keep the name readable over a photo. */
		.still .cap {
			background: var(--bg);
		}
	}
</style>
