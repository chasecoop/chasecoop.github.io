---
import { type CollectionEntry, render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, summarize } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, older: posts[i + 1] },
	}));
}
interface Props {
	post: CollectionEntry<'blog'>;
	older?: CollectionEntry<'blog'>;
}

const { post, older } = Astro.props;
const { title, pubDate, updatedDate } = post.data;
const description = summarize(post);
const { Content } = await render(post);
---

<Base title={title} description={description} type="article">
	<article class="col page">
		<p class="crumb">
			<a class="dim" href="/blog/">blog</a> / <FormattedDate date={pubDate} />
			{
				updatedDate && (
					<>
						{' '}
						(updated <FormattedDate date={updatedDate} />)
					</>
				)
			}
		</p>
		<h1 class="title">{title}</h1>

		<div class="prose body">
			<Content />
		</div>

		<nav class="pager" aria-label="More posts">
			<a href="/blog/">&lt;- all posts</a>
			{
				older && (
					<span>
						<span class="muted">older </span>
						<a class="quiet" href={`/blog/${older.id}/`}>
							{older.data.title}
						</a>
					</span>
				)
			}
		</nav>
	</article>
</Base>

<style>
	.page {
		margin-top: var(--space-6);
	}
	.body {
		margin-top: var(--space-5);
	}
</style>
