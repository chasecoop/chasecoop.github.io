---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page doesn't exist.">
	<div class="col page">
		<p class="crumb">404</p>
		<h1 class="title">Nothing here.</h1>
		<p class="line">That page doesn't exist, or it moved. Try the <a href="/">home page</a>.</p>
	</div>
</Base>

<style>
	.page {
		margin-top: var(--space-6);
	}
	.line {
		margin-top: var(--space-4);
	}
</style>
