---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
}

const { title, description, type } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} type={type} />
		<slot name="head" />
	</head>
	<body>
		<div class="shell">
			<Header />
			<div class="content">
				<main id="main">
					<slot />
				</main>
				<Footer />
			</div>
		</div>
	</body>
</html>
