---
const year = new Date().getFullYear();
---

<footer class="col">
	<div>
		<span class="links">
			<a class="dim" href="/rss.xml">rss</a>
			<a class="dim" href="https://github.com/chasecoop" rel="me noopener">github</a>
			<a class="dim" href="/about/">about</a>
		</span>
		<span>snarezm.com, {year}</span>
	</div>
</footer>

<style>
	footer {
		margin-top: var(--space-6);
	}
	div {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2) var(--space-4);
		padding: var(--space-4) 0 var(--space-5);
		border-top: 1px solid var(--rule);
		font-size: var(--text-xs);
		color: var(--muted);
	}
	.links {
		display: flex;
		gap: var(--space-4);
	}
</style>
