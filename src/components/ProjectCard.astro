---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, thumbnail, tech, date } = project.data;
---

<article>
	<a href={`/projects/${project.id}/`}>
		<div class="thumb">
			{thumbnail ? <Image src={thumbnail} width={640} height={400} alt="" /> : <span aria-hidden="true">{title.charAt(0)}</span>}
		</div>
		<h3>{title}</h3>
	</a>
	<p>{summary}</p>
	<p class="meta">{date.getUTCFullYear()} · {tech.join(' / ')}</p>
</article>

<style>
	article a {
		text-decoration: none;
	}
	.thumb {
		aspect-ratio: 16 / 10;
		background: var(--code-bg);
		border: 1px solid var(--rule);
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.thumb span {
		font-size: var(--step-3);
		font-style: italic;
		color: var(--ink-soft);
	}
	h3 {
		margin: 0.9rem 0 0.3rem;
	}
	article a:hover .thumb {
		border-color: var(--accent);
	}
	p {
		margin: 0 0 0.4rem;
		color: var(--ink-soft);
	}
</style>
