---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, thumbnail, date } = project.data;

// A tile is the project's own SVG (src/assets/thumbs/<id>.svg), drawn with
// currentColor so it follows the theme. Raster thumbnails also work.
const svgs = import.meta.glob<string>('../assets/thumbs/*.svg', { query: '?raw', import: 'default', eager: true });
const svg = svgs[`../assets/thumbs/${project.id}.svg`];
---

<a class="proj" href={`/projects/${project.id}/`}>
	<span class="tile">
		{
			svg ? (
				<Fragment set:html={svg} />
			) : thumbnail ? (
				<Image src={thumbnail} width={480} height={480} alt="" />
			) : (
				<span class="letter" aria-hidden="true">
					{title.charAt(0)}
				</span>
			)
		}
		<span class="run" aria-hidden="true">run -&gt;</span>
	</span>
	<span class="caption">
		<span class="name">{title}</span>
		<span class="muted">{date.getUTCFullYear()}</span>
	</span>
</a>

<style>
	.proj {
		display: block;
		color: var(--fg);
	}
	.proj:hover {
		text-decoration: none;
	}
	.tile {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 1 / 1;
		overflow: hidden;
		background: var(--tile-bg);
		color: var(--tile-fg);
		border: 2px solid var(--tile-bg);
		border-radius: var(--radius);
	}
	.tile :global(svg),
	.tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.letter {
		font-size: var(--text-xl);
	}
	.run {
		position: absolute;
		right: var(--space-2);
		bottom: var(--space-2);
		padding: 0 var(--space-1);
		font-size: var(--text-xs);
		background: var(--tile-bg);
		opacity: 0;
	}
	.caption {
		display: flex;
		justify-content: space-between;
		gap: var(--space-2);
		margin-top: var(--space-2);
		font-size: var(--text-sm);
	}
	.proj:hover .tile,
	.proj:focus-visible .tile {
		border-color: var(--link);
	}
	.proj:hover .run,
	.proj:focus-visible .run {
		opacity: 1;
	}
	.proj:hover .name {
		color: var(--link);
	}
</style>
