---
import { SITE_TITLE } from '../consts';

interface Props {
	// Full-width bar, for pages like /launch/ that run edge to edge.
	wide?: boolean;
}

const { wide = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
	{ href: '/projects/', label: 'projects', current: path === '/' || path.startsWith('/projects/') },
	{ href: '/blog/', label: 'blog', current: path.startsWith('/blog/') },
	{ href: '/launch/', label: 'launch', current: path.startsWith('/launch/') },
	{ href: 'https://github.com/chasecoop', label: 'github', current: false },
];
---

<header class:list={[wide ? 'bar' : 'col']}>
	<a class="skip-link" href="#main">Skip to content</a>
	<a class="quiet" href="/">{SITE_TITLE}</a>
	<nav aria-label="Main">
		{
			links.map(({ href, label, current }) => (
				<a class="quiet" href={href} aria-current={current ? 'page' : undefined} rel={href.startsWith('http') ? 'me noopener' : undefined}>
					{label}
				</a>
			))
		}
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-2) var(--space-4);
		padding-top: var(--space-5);
	}
	.bar {
		padding: var(--space-3) var(--gutter);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}
	[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--muted);
		text-underline-offset: 4px;
	}
</style>
