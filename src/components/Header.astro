---
import { SITE_TITLE } from '../consts';

// The left rail (direction B from the Claude Design mockups). On phones it becomes
// a bar across the top.
const path = Astro.url.pathname;
const links = [
	{ href: '/projects/', label: 'projects', current: path === '/' || path.startsWith('/projects/') },
	{ href: '/blog/', label: 'blog', current: path.startsWith('/blog/') },
	{ href: 'https://github.com/chasecoop', label: 'github', current: false },
];
---

<header>
	<a class="skip-link" href="#main">Skip to content</a>
	<a class="quiet name" href="/">{SITE_TITLE}</a>
	<nav aria-label="Main">
		{
			links.map(({ href, label, current }) => (
				<a class="dim" href={href} aria-current={current ? 'page' : undefined} rel={href.startsWith('http') ? 'me noopener' : undefined}>
					{label}
				</a>
			))
		}
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		flex: 0 0 var(--rail);
		padding: var(--page-top) var(--space-3) var(--space-4) var(--gutter);
	}
	.name {
		display: block;
		margin-bottom: var(--space-3);
		font-weight: 500;
	}
	nav a {
		display: block;
		padding: var(--space-1) 0;
	}
	nav [aria-current='page'] {
		color: var(--link);
	}
	@media (max-width: 640px) {
		header {
			position: static;
			padding: var(--space-4) var(--gutter) var(--space-2);
		}
		.name {
			margin-bottom: var(--space-1);
		}
		nav {
			display: flex;
			flex-wrap: wrap;
			gap: 0 var(--space-4);
		}
		nav a {
			padding: var(--space-2) 0;
		}
	}
</style>
