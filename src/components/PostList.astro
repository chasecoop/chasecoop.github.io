---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ol>
	{
		posts.map((post) => (
			<li class="row">
				<FormattedDate date={post.data.pubDate} />
				<span>
					<a class="quiet" href={`/blog/${post.id}/`}>
						{post.data.title}
					</a>
					{post.data.draft && <span class="muted"> (draft)</span>}
				</span>
			</li>
		))
	}
</ol>

<style>
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>
